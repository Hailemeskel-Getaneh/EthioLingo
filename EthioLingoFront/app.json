{
  "expo": {
    "name": "EthioLingoFront",
    "slug": "EthioLingoFront",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "_comment": {
      "plugins": [
        [
          "@react-native-google-signin/google-signin",
          {
            "iosUrlScheme": "com.googleusercontent.apps._some_id_here_"
          }
        ]
      ]
    },
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/e.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.EthioLingoFront"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/e.jpg",
        "backgroundColor": "#ffffff"
      },
      "package": "com.anonymous.EthioLingoFront"
    },
    "permissions": [
      "RECORD_AUDIO"
    ],
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "b6a20617-8d80-48a9-9eb4-282c7372a09d"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-sqlite"
    ]
  }
}
